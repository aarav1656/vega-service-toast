{
  "name": "vega-service-toast",
  "version": "0.1.0",
  "description": "Raise a system toast over whatever app is on screen from a headless service on Vega OS (Fire TV).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {"vega-service-toast": "bin/vega-service-toast.mjs"},
  "files": ["dist", "bin", "templates", "example", "evidence"],
  "keywords": ["vega", "fire-tv", "kepler", "toast", "notification", "headless", "service"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-timeout=15000 test/*.test.mjs && node test/mutate.mjs"
  },
  "dependencies": {"smol-toml": "^1.3.0"},
  "peerDependencies": {
    "@amazon-devices/headless-task-manager": ">=1.2.0",
    "@amazon-devices/react-native-kepler": ">=4.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {"typescript": "5.8.3"}
}
